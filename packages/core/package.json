{
  "name": "@chaingang/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./behaviors": {
      "import": "./dist/behaviors/index.js",
      "types": "./dist/behaviors/index.d.ts"
    },
    "./render": {
      "import": "./dist/render/index.js",
      "types": "./dist/render/index.d.ts"
    },
    "./timeline": {
      "import": "./dist/timeline/index.js",
      "types": "./dist/timeline/index.d.ts"
    },
    "./audio": {
      "import": "./dist/audio/index.js",
      "types": "./dist/audio/index.d.ts"
    },
    "./entities": {
      "import": "./dist/entities/index.js",
      "types": "./dist/entities/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "p5": "^1.11.0"
  },
  "devDependencies": {
    "@types/p5": "^1.7.6",
    "typescript": "^5.3.0"
  }
}
